BACKUP ~weidu_external/BattleSense/backup~
AUTHOR ~JasZy, https://github.com/JasZy~
VERSION ~v0.1.0~

///////////////
// Functions //
///////////////

// WeiDU only allows actions inside a component; ALWAYS runs these at the start of every component.
ALWAYS

	// Installs the files every module needs. Only the first module to be installed copies the startup file, which
	// holds which modules are on; if that module is later uninstalled, WeiDU reinstalls the modules that came after it,
	// and the next one in line copies it again. The strings and shared helpers are copied by every module, so a module
	// added to an existing install gets the strings it needs.
	DEFINE_ACTION_FUNCTION ZJ_BATTLESENSE_INSTALL_CORE BEGIN
		ACTION_IF !FILE_EXISTS ~override/M_ZJBSen.lua~ BEGIN
			COPY ~BattleSense/copy/core~ ~override~
		END ELSE BEGIN
			COPY ~BattleSense/copy/core/ZJ-en_US.lua~ ~override~
			     ~BattleSense/copy/core/ZJSprite.lua~ ~override~
			     ~BattleSense/copy/core/ZJBarCol.lua~ ~override~
			     ~BattleSense/copy/core/ZJPopup.lua~ ~override~
			     ~BattleSense/copy/core/ZJPopup.menu~ ~override~
			     ~BattleSense/copy/core/ZJArea.lua~ ~override~
		END
	END

	// Turns a module on in the startup file. A startup file copied by an older version of Battle Sense doesn't list
	// modules added since, those are added to its module list and start order.
	DEFINE_ACTION_FUNCTION ZJ_BATTLESENSE_ENABLE_MODULE
		STR_VAR
			module = ~~
	BEGIN
		COPY ~override/M_ZJBSen.lua~ ~override~
			PATCH_IF (INDEX_BUFFER (~\["%module%"\]~) < 0) BEGIN
				REPLACE_TEXTUALLY ~ZJBattleSense_Modules = {~ ~ZJBattleSense_Modules = {%WNL%%TAB%["%module%"] = true,~
				REPLACE_TEXTUALLY ~ZJBattleSense_Private_ModuleOrder = {~ ~ZJBattleSense_Private_ModuleOrder = { "%module%",~
			END ELSE BEGIN
				REPLACE_TEXTUALLY ~^\([ %TAB%]*\["%module%"\][ %TAB%]*=[ %TAB%]*\)false~ ~\1true~
			END
		BUT_ONLY
	END

END

LANGUAGE ~English~ ~english~ ~BattleSense/language/english/setup.tra~

/////////////////////////////////////////////////////////////////////////////////////////////////////////
// Creature Info: To-hit chances, damage and timers when hovering a creature in a fight                //
/////////////////////////////////////////////////////////////////////////////////////////////////////////

BEGIN @10 LABEL ~ZJ-BattleSense-Creature-Info~ DESIGNATED 10
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet iwdee~ @1000 // Game not supported.
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ 1 @1001 // Battle Sense requires EEex to be installed first.

	LAF ZJ_BATTLESENSE_INSTALL_CORE END
	COPY ~BattleSense/copy/creatureinfo~ ~override~
	LAF ZJ_BATTLESENSE_ENABLE_MODULE STR_VAR module = ~ZJCreInf~ END

/////////////////////////////////////////////////////////////////////////////////////////////////////////
// Timer: Casting, attack round, modal and contingency bars, and resistance rings, beside portraits    //
/////////////////////////////////////////////////////////////////////////////////////////////////////////

BEGIN @20 LABEL ~ZJ-BattleSense-Timer~ DESIGNATED 20
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet iwdee~ @1000 // Game not supported.
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ 1 @1001 // Battle Sense requires EEex to be installed first.

	LAF ZJ_BATTLESENSE_INSTALL_CORE END
	COPY ~BattleSense/copy/timer~ ~override~
	LAF ZJ_BATTLESENSE_ENABLE_MODULE STR_VAR module = ~ZJTimer~ END

