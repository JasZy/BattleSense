
-- Never opened. It only holds the templates that ZJAbilityInfo injects into the abilities screen of character creation, (see
-- ZJAbilityInfo_Private_Inject()). A menu pushed on top of that screen would be closed by its Done / Back buttons, (they
-- call Infinity_PopMenu() without a name), in place of the screen itself.
menu
{
	name "ZJAbilityInfo_Menu"
	ignoreesc

	-- Evaluated every frame while the abilities screen is open: works out the row under the cursor, lays out the popup,
	-- and draws its background. Always returns false, so it draws nothing of its own.
	template
	{
		label
		{
			enabled "ZJAbilityInfo_Private_Tick()"
		}
		name "ZJAbilityInfo_Menu_TEMPLATE_Ticker"
	}

	-- The popup's text, (area set in ZJAbilityInfo_Private_Layout())
	template
	{
		label
		{
			enabled "ZJAbilityInfo_Private_Menu_IsOpen"
			text style "normal"
			text lua "ZJAbilityInfo_Private_Menu_Text"
			text align left top
			text color 255 255 255 255
		}
		name "ZJAbilityInfo_Menu_TEMPLATE_Text"
	}
}
