menu
{
	name "ZJTimer_Menu"
	ignoreesc

	-- The engine won't change the cursor type over templates if there isn't at
	-- least one "normal" element that occupies an xy of equal or greater value.
	label
	{
		area 0 0 2147483647 2147483647
		enabled "ZJTimer_Private_Menu_Tick()"
	}

	template
	{
		label
		{
			enabled "ZJTimer_Private_Menu_TEMPLATE_Background_Enabled()"
			bam "ZJTBACKG"
			scaleToClip
		}
		name "ZJTimer_Menu_TEMPLATE_Background"
	}

	-- The bars, a fill in the color of the bar's option, (area set in ZJTimer.lua: its height is how full it is)

	template
	{
		label
		{
			enabled "ZJTimer_Private_Menu_TEMPLATE_Enabled('ZJTimer_Menu_TEMPLATE_TimerModal')"
			fill lua "ZJBarColors_Fill('Modal')"
		}
		name "ZJTimer_Menu_TEMPLATE_TimerModal"
	}

	template
	{
		label
		{
			enabled "ZJTimer_Private_Menu_TEMPLATE_Enabled('ZJTimer_Menu_TEMPLATE_TimerContingency')"
			fill lua "ZJBarColors_Fill('Contingency')"
		}
		name "ZJTimer_Menu_TEMPLATE_TimerContingency"
	}

	template
	{
		label
		{
			enabled "ZJTimer_Private_Menu_TEMPLATE_Enabled('ZJTimer_Menu_TEMPLATE_TimerCast')"
			fill lua "ZJBarColors_Fill('Cast')"
		}
		name "ZJTimer_Menu_TEMPLATE_TimerCast"
	}

	template
	{
		label
		{
			enabled "ZJTimer_Private_Menu_TEMPLATE_CastMarker_Enabled()"
			bam "ZJTAMARK"
			scaleToClip
		}
		name "ZJTimer_Menu_TEMPLATE_CastMarker"
	}

	template
	{
		label
		{
			enabled "ZJTimer_Private_Menu_TEMPLATE_Enabled('ZJTimer_Menu_TEMPLATE_TimerAttack')"
			fill lua "ZJBarColors_Fill('Attack')"
		}
		name "ZJTimer_Menu_TEMPLATE_TimerAttack"
	}

	template
	{
		label
		{
			enabled "ZJTimer_Private_Menu_TEMPLATE_AttackMarker_Enabled()"
			bam "ZJTAMARK"
			scaleToClip
		}
		name "ZJTimer_Menu_TEMPLATE_AttackMarker"
	}

	-- A resistance ring: the element's icon, (ZJCREELM.BAM, shared with Creature Info), with the white ring of ZJTRRING.BAM
	-- around it twice: the whole ring in the "not resisted" color, and the resisted part on top in the "resisted"
	-- color. Like the bars, each has a template per color.
	template
	{
		label
		{
			enabled "ZJTimer_Private_Menu_TEMPLATE_Enabled('ZJTimer_Menu_TEMPLATE_ResistIcon')"
			bam "ZJCREELM"
			scaleToClip
			frame lua "ZJTimer_Private_Menu_TEMPLATE_Frame('ZJTimer_Menu_TEMPLATE_ResistIcon')"
		}
		name "ZJTimer_Menu_TEMPLATE_ResistIcon"
	}

	template
	{
		label
		{
			enabled "ZJTimer_Private_Menu_TEMPLATE_Enabled('ZJTimer_Menu_TEMPLATE_ResistUnresisted1')"
			bam "ZJTRRING"
			scaleToClip
			frame lua "ZJTimer_Private_ResistRingMaxFrame"
			useOverlayTint "true"
			overlayTint 230 0 0
		}
		name "ZJTimer_Menu_TEMPLATE_ResistUnresisted1"
	}

	template
	{
		label
		{
			enabled "ZJTimer_Private_Menu_TEMPLATE_Enabled('ZJTimer_Menu_TEMPLATE_ResistUnresisted2')"
			bam "ZJTRRING"
