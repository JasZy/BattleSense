-- Always open while a game is running, looks for a locked container / door or a detected trap under the cursor
menu
{
	name "ZJLockInfo_Menu_Ticker"
	ignoreesc

	label
	{
		opacity lua "ZJLockInfo_Private_Tick()"
	}
}

-- The popup, opened on top of everything else while it has something to say (areas set in ZJLockInfo_Private_Layout())
menu
{
	name "ZJLockInfo_Menu"
	ignoreesc

	label
	{
		name "ZJLockInfo_Menu_BackgroundRect"
		area 0 0 -1 -1
	}

	label
	{
		name "ZJLockInfo_Menu_Text"
		area -1 -1 -1 -1
		text style "normal"
		text lua "ZJLockInfo_Private_Menu_Text"
		text color 255 255 255 255
		text align left top
	}
}
