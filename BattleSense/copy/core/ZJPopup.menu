-- Always open while a game is running: while the "Open Popup" key is held, asks the modules' panels for what is under the
-- cursor, (ZJPopup_Tick(), which the character creation screens also call themselves)
menu
{
	name "ZJPopup_Cursor_Ticker"
	ignoreesc

	label
	{
		opacity lua "ZJPopup_Tick()"
	}
}

-- The popup's box of text, opened on top of everything else while a text panel has something to say (areas set in
-- ZJPopup_Private_Layout()). It only draws while it is updated every frame, see ZJPopup_Private_IsFresh().
menu
{
	name "ZJPopup_Cursor"
	ignoreesc

	label
	{
		name "ZJPopup_Cursor_Background"
		area 0 0 -1 -1
		enabled "ZJPopup_Private_IsFresh()"
	}

	label
	{
		name "ZJPopup_Cursor_Text"
		area -1 -1 -1 -1
		enabled "ZJPopup_Private_IsFresh()"
		text style "normal"
		text lua "ZJPopup_Private_Text"
		text color 255 255 255 255
		text align left top
	}
}
